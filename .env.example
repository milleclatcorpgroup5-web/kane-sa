# Obligatwa pou Supabase (mete valè yo nan .env.local lokalman, epi nan Cloudflare Secrets/Variables)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Firebase opsyonèl: notifikasyon push/analytics. Pa mete private service-account key isit la.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Pa janm mete SUPABASE_SERVICE_ROLE_KEY oswa sekrè MonCash/NatCash nan NEXT_PUBLIC_ variables.
# Nan moman sa a, entegrasyon MonCash/NatCash poko aktive.

# URL piblik sit la (robots.txt ak sitemap)
NEXT_PUBLIC_SITE_URL=https://ou-domen.com

# Sèvè sèlman (secrets Cloudflare, pa NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_SERVICE_ACCOUNT=

# Tès E2E opsyonèl
E2E_EMAIL=
E2E_PASSWORD=

# Espas lajan reyèl la LOCKED nan v1.7.0-dev.0.
# Pa ajoute sekrè provider jiskaske kontra/API ofisyèl, sandbox ak odit fin fèt.
# Valè sa yo se enfòmasyon; yo pa kapab aktive mouvman lajan nan kòd vèsyon sa a.
KANE_REAL_MONEY_ENABLED=false
KANE_PROVIDER_SANDBOX_ENABLED=false
